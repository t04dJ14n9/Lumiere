+// Focused regression for the PDF engine URL contract in the DSH e2e suite.
+//
+//   node --test packages/dsh/test/e2e/pdf-engine-url.test.mjs
+//
+// This is not a live DSH e2e run. It renders HTML the same way
+// packages/pdf/src/shared/viewer-page.ts interpolates asset("embedpdf.wasm")
+// into data-pdfium-wasm, then checks the e2e predicates against that HTML
+// and against the filename copied by packages/markdown/scripts/build.mjs.
+// It must reject the historical wrong URL and accept only the shipped path.
+import assert from "node:assert/strict";
+import { readFileSync } from "node:fs";
+import path from "node:path";
+import { describe, it } from "node:test";
+import { fileURLToPath } from "node:url";
+
+import {
+  ENGINE_ATTR,
+  SHIPPED_ENGINE_PATH,
+  htmlDeclaresShippedEngine,
+  isShippedEngineAsset,
+} from "./pdf-engine-url.mjs";
+
+const repoRoot = path.resolve(
+  path.dirname(fileURLToPath(import.meta.url)),
+  "../../../..",
+);
+
+function readRepo(rel) {
+  return readFileSync(path.join(repoRoot, rel), "utf8");
+}
+
+function engineFilenameFromViewerPage(source) {
+  const match = source.match(
+    /<div id="root" data-pdfium-wasm="\$\{asset\("([^"]+)"\)\}"/,
+  );
+  assert.ok(
+    match,
+    "viewer-page.ts root tag must interpolate asset(...) into data-pdfium-wasm",
+  );
+  return match[1];
+}
+
+function renderViewerRoot(asset, engineFilename) {
+  return `<div id="root" data-pdfium-wasm="${asset(engineFilename)}"></div>`;
+}
+
+function assetFromPdfRoutes(source, name, base = "/lumiere") {
+  const match = source.match(
+    /asset:\s*\(name\)\s*=>\s*name === "([^"]+)"\s*\?\s*`\$\{base\}\/m\/webview\/([^`]+)`\s*:\s*`\$\{base\}\/pdf\/viewer\/\$\{name\}`/,
+  );
+  assert.ok(match, "pdf-routes.ts must expose the asset special-case");
+  const specialName = match[1];
+  return name === specialName
+    ? `${base}/m/webview/${match[2]}`
+    : `${base}/pdf/viewer/${name}`;
+}
+
+function intendedAsset(name, base = "/lumiere") {
+  return name === "embedpdf.wasm"
+    ? `${base}/m/webview/embedpdf.wasm`
+    : `${base}/pdf/viewer/${name}`;
+}
+
+const viewerPage = readRepo("packages/pdf/src/shared/viewer-page.ts");
+const pdfRoutes = readRepo("packages/host-node/src/host/pdf-routes.ts");
+const markdownBuild = readRepo("packages/markdown/scripts/build.mjs");
+const engineFilename = engineFilenameFromViewerPage(viewerPage);
+
+describe("PDF engine URL contract used by DSH e2e", () => {
+  it("reads the shipped engine filename from viewer-page and the markdown copy", () => {
+    assert.equal(engineFilename, "embedpdf.wasm");
+    assert.match(
+      markdownBuild,
+      /@embedpdf\/engine-runtime-wasm32\/embedpdf\.wasm/,
+    );
+    assert.match(markdownBuild, /dist\/webview\/embedpdf\.wasm/);
+    assert.equal(ENGINE_ATTR, "data-pdfium-wasm");
+    assert.equal(SHIPPED_ENGINE_PATH, "/lumiere/m/webview/embedpdf.wasm");
+  });
+
+  it("rejects the historical wrong HTML URL that the old name-only check accepted", () => {
+    const wrongHtml = renderViewerRoot(
+      (name) => `/lumiere/pdf/viewer/${name}`,
+      engineFilename,
+    );
+    assert.equal(
+      wrongHtml,
+      `<div id="root" data-pdfium-wasm="/lumiere/pdf/viewer/embedpdf.wasm"></div>`,
+    );
+    // The old `html.includes("data-pdfium-wasm")` check would accept this.
+    assert.equal(
+      htmlDeclaresShippedEngine(wrongHtml),
+      false,
+      "must reject HTML whose data-pdfium-wasm URL is not the shipped path",
+    );
+  });
+
+  it("accepts HTML that declares the exact shipped engine URL", () => {
+    const okHtml = renderViewerRoot(intendedAsset, engineFilename);
+    assert.equal(
+      okHtml,
+      `<div id="root" data-pdfium-wasm="${SHIPPED_ENGINE_PATH}"></div>`,
+    );
+    assert.equal(htmlDeclaresShippedEngine(okHtml), true);
+  });
+
+  it("treats only the shipped embedpdf.wasm path as the GET target", () => {
+    assert.equal(isShippedEngineAsset("/lumiere/m/webview/pdfium.wasm"), false);
+    assert.equal(
+      isShippedEngineAsset("/lumiere/pdf/viewer/embedpdf.wasm"),
+      false,
+    );
+    assert.equal(isShippedEngineAsset(SHIPPED_ENGINE_PATH), true);
+  });
+
+  it("routes the engine through the shipped editor webview path", () => {
+    const currentHtml = renderViewerRoot(
+      (name) => assetFromPdfRoutes(pdfRoutes, name),
+      engineFilename,
+    );
+    assert.equal(htmlDeclaresShippedEngine(currentHtml), true);
+    assert.equal(
+      currentHtml,
+      `<div id="root" data-pdfium-wasm="${SHIPPED_ENGINE_PATH}"></div>`,
+    );
+  });
+});
diff --git a/packages/dsh/test/e2e/render-oracles.mjs b/packages/dsh/test/e2e/render-oracles.mjs
new file mode 100644
index 00000000..cb8d0c21
--- /dev/null
+++ b/packages/dsh/test/e2e/render-oracles.mjs
@@ -0,0 +1,166 @@
+// Oracles and small wait/provenance helpers for the DSH e2e browser
+// image and PDF-render scenarios. These do not run a browser or an
+// installed bundle.
+
+// short.pdf is packages/pdf/test/fixtures/make-fixtures.mjs shortPdf():
+// three 300x400 pages whose painted label is "Short page N".
+export const SHORT_PDF_PAGE_COUNT = 3;
+export const SHORT_PDF_TOOLBAR_SUFFIX = `of ${SHORT_PDF_PAGE_COUNT}`;
+
+// engine.tsx Status copy. A nonempty placeholder is not a rendered page.
+export const PDF_LOADING_TEXTS = [
+  "Starting the PDF engine…",
+  "Opening the PDF…",
+];
+
+// Longer than engine.tsx WORKER_TIMEOUT_MS (15s) so a main-thread fallback
+// can still succeed; this is a deadline, not a fixed sleep.
+export const PDF_RENDER_TIMEOUT_MS = 20_000;
+export const IMAGE_ATTEMPT_TIMEOUT_MS = 8_000;
+
+export function isPdfLoadingPlaceholder(bodyText) {
+  return PDF_LOADING_TEXTS.some((text) => bodyText.includes(text));
+}
+
+export function isPixelFileUrl(url) {
+  return url.includes("/lumiere/file") && url.includes("pixel.png");
+}
+
+export function imageHasDecoded({
+  currentNavHttp200,
+  imageCount,
+  complete,
+  naturalWidth,
+}) {
+  if (!currentNavHttp200) {
+    return {
+      ok: false,
+      reason: "image was never fetched through /lumiere/file",
+    };
+  }
+  if (!(imageCount > 0 && complete === true && naturalWidth > 0)) {
+    return {
+      ok: false,
+      reason:
+        imageCount > 0
+          ? `image failed to decode (complete ${complete}, naturalWidth ${naturalWidth})`
+          : "no image in the DOM",
+    };
+  }
+  return { ok: true };
+}
+
+// One log per page/attempt. Record only on the attempt that issued the
+// request; a delayed arrival must not be written to a later attempt.
+export function createAttemptLog() {
+  const events = [];
+  return {
+    record(url, status) {
+      if (isPixelFileUrl(url)) {
+        events.push(status);
+      }
+    },
+    hasHttp200() {
+      return events.includes(200);
+    },
+  };
+}
+
+export function pdfViewerHasRendered({
+  bodyText,
+  hasViewer,
+  firstPageDecoded,
+  toolbarPageCount,
+  bytesOk,
+  errors,
+}) {
+  if (bodyText.includes("could not be opened")) {
+    return { ok: false, reason: "PDF failed to open" };
+  }
+  if (bodyText.includes("Lumiere could not open:")) {
+    return { ok: false, reason: "bootstrap error shown" };
+  }
+  if (errors.length > 0) {
+    return {
+      ok: false,
+      reason: `console errors: ${errors.slice(0, 2).join(" | ")}`,
+    };
+  }
+  if (!bytesOk) {
+    return { ok: false, reason: "the page never fetched its PDF bytes" };
+  }
+  if (!firstPageDecoded || !hasViewer) {
+    const loading = isPdfLoadingPlaceholder(bodyText)
+      ? "loading placeholder, no rendered page"
+      : "no rendered PDF page";
+    return { ok: false, reason: loading };
+  }
+  if (toolbarPageCount !== SHORT_PDF_PAGE_COUNT) {
+    return {
+      ok: false,
+      reason: `toolbar page count is not the short.pdf fixture (got ${toolbarPageCount})`,
+    };
+  }
+  return { ok: true };
+}
+
+export function isDefinitivePdfFailure(verdict) {
+  return (
+    !verdict.ok &&
+    (verdict.reason === "PDF failed to open" ||
+      verdict.reason === "bootstrap error shown" ||
+      String(verdict.reason).startsWith("console errors:"))
+  );
+}
+
+async function defaultSleep(ms) {
+  await new Promise((resolve) => setTimeout(resolve, ms));
+}
+
+export async function waitForReady(readVerdict, options = {}) {
+  const timeout = options.timeout;
+  const interval = options.interval ?? 50;
+  const now = options.now ?? Date.now;
+  const sleep = options.sleep ?? defaultSleep;
+  const isFinal = options.isFinal ?? ((verdict) => verdict.ok);
+  const deadline = now() + timeout;
+  let verdict = await readVerdict();
+  if (isFinal(verdict)) {
+    return verdict;
+  }
+  while (now() < deadline) {
+    const remaining = deadline - now();
+    if (remaining <= 0) {
+      break;
+    }
+    await sleep(Math.min(interval, remaining));
+    verdict = await readVerdict();
+    if (isFinal(verdict)) {
+      return verdict;
+    }
+  }
+  return verdict;
+}
+
+export async function waitForImageReady(read, options) {
+  return waitForReady(async () => imageHasDecoded(await read()), options);
+}
+
+export async function waitForPdfReady(read, options) {
+  return waitForReady(async () => pdfViewerHasRendered(await read()), {
+    ...options,
+    isFinal: (verdict) => verdict.ok || isDefinitivePdfFailure(verdict),
+  });
+}
+
+export async function afterSuccessfulNavigation(goto, then) {
+  const response = await goto();
+  const status =
+    typeof response?.status === "function"
+      ? response.status()
+      : response?.status;
+  if (status !== 200) {
+    return { ok: false, reason: `HTTP ${status}` };
+  }
+  return then(response);
+} /* global setTimeout */
diff --git a/packages/dsh/test/e2e/render-oracles.test.mjs b/packages/dsh/test/e2e/render-oracles.test.mjs
new file mode 100644
index 00000000..3e433cc8
--- /dev/null
+++ b/packages/dsh/test/e2e/render-oracles.test.mjs
@@ -0,0 +1,384 @@
+// Focused regressions for the DSH e2e image-decode and PDF-render oracles.
+//
+//   node --test packages/dsh/test/e2e/render-oracles.test.mjs
+//
+// Source-level only: these fixtures are snapshots, not a Playwright page,
+// an installed bundle, or a live DSH run. A pass here is not a browser or
+// GUI pass.
+import assert from "node:assert/strict";
+import { describe, it } from "node:test";
+
+import {
+  SHORT_PDF_PAGE_COUNT,
+  SHORT_PDF_TOOLBAR_SUFFIX,
+  PDF_LOADING_TEXTS,
+  PDF_RENDER_TIMEOUT_MS,
+  afterSuccessfulNavigation,
+  createAttemptLog,
+  imageHasDecoded,
+  isPdfLoadingPlaceholder,
+  pdfViewerHasRendered,
+  waitForImageReady,
+  waitForPdfReady,
+} from "./render-oracles.mjs";
+
+function createClock() {
+  let current = 0;
+  const sleepers = [];
+  return {
+    now: () => current,
+    sleep(ms) {
+      return new Promise((resolve) => {
+        sleepers.push({ due: current + ms, resolve });
+      });
+    },
+    async advance(ms) {
+      current += ms;
+      const due = sleepers
+        .filter((entry) => entry.due <= current)
+        .sort((a, b) => a.due - b.due);
+      for (const entry of due) {
+        const index = sleepers.indexOf(entry);
+        if (index >= 0) {
+          sleepers.splice(index, 1);
+        }
+        entry.resolve();
+      }
+      for (let i = 0; i < 8; i += 1) {
+        await Promise.resolve();
+      }
+    },
+  };
+}
+
+async function flush() {
+  for (let i = 0; i < 8; i += 1) {
+    await Promise.resolve();
+  }
+}
+
+describe("image decode oracle", () => {
+  it("rejects HTTP 200 with zero images in the DOM", () => {
+    const verdict = imageHasDecoded({
+      currentNavHttp200: true,
+      imageCount: 0,
+      complete: false,
+      naturalWidth: 0,
+    });
+    assert.equal(verdict.ok, false, "zero-image after HTTP 200 must not pass");
+  });
+
+  it("rejects an image element that has not decoded", () => {
+    const verdict = imageHasDecoded({
+      currentNavHttp200: true,
+      imageCount: 1,
+      complete: false,
+      naturalWidth: 0,
+    });
+    assert.equal(verdict.ok, false);
+  });
+
+  it("accepts a current-navigation 200 plus a decoded image", () => {
+    const verdict = imageHasDecoded({
+      currentNavHttp200: true,
+      imageCount: 1,
+      complete: true,
+      naturalWidth: 1,
+    });
+    assert.equal(verdict.ok, true);
+  });
+
+  it("does not let a previous attempt's 200 satisfy a later attempt", () => {
+    const previous = createAttemptLog();
+    const current = createAttemptLog();
+    previous.record("http://127.0.0.1/lumiere/file?path=pixel.png", 200);
+    assert.equal(previous.hasHttp200(), true);
+    assert.equal(current.hasHttp200(), false);
+    const verdict = imageHasDecoded({
+      currentNavHttp200: current.hasHttp200(),
+      imageCount: 0,
+      complete: false,
+      naturalWidth: 0,
+    });
+    assert.equal(verdict.ok, false);
+  });
+
+  it("rejects a complete image with no decoded dimensions", () => {
+    const verdict = imageHasDecoded({
+      currentNavHttp200: true,
+      imageCount: 1,
+      complete: true,
+      naturalWidth: 0,
+    });
+    assert.equal(verdict.ok, false);
+  });
+});
+
+describe("PDF render oracle", () => {
+  it("knows the short.pdf fixture contract and loading copy", () => {
+    assert.equal(SHORT_PDF_PAGE_COUNT, 3);
+    assert.equal(SHORT_PDF_TOOLBAR_SUFFIX, "of 3");
+    assert.ok(PDF_RENDER_TIMEOUT_MS > 15_000);
+    assert.ok(isPdfLoadingPlaceholder("Starting the PDF engine…"));
+    assert.ok(isPdfLoadingPlaceholder("Opening the PDF…"));
+    assert.equal(isPdfLoadingPlaceholder("Short page 1"), false);
+    assert.deepEqual(PDF_LOADING_TEXTS, [
+      "Starting the PDF engine…",
+      "Opening the PDF…",
+    ]);
+  });
+
+  it("rejects a stalled engine: bytes fetched, loading placeholder, no page", () => {
+    const starting = pdfViewerHasRendered({
+      bodyText: "Starting the PDF engine…",
+      hasViewer: false,
+      firstPageDecoded: false,
+      toolbarPageCount: null,
+      bytesOk: true,
+      errors: [],
+    });
+    assert.equal(
+      starting.ok,
+      false,
+      "stalled engine startup must not pass as a rendered page",
+    );
+    const opening = pdfViewerHasRendered({
+      bodyText: "Opening the PDF…",
+      hasViewer: false,
+      firstPageDecoded: false,
+      toolbarPageCount: null,
+      bytesOk: true,
+      errors: [],
+    });
+    assert.equal(
+      opening.ok,
+      false,
+      "document-opening placeholder must not pass as a rendered page",
+    );
+  });
+
+  it("accepts a decoded first page, the short.pdf toolbar count, and a byte fetch", () => {
+    const verdict = pdfViewerHasRendered({
+      bodyText: "1 of 3",
+      hasViewer: true,
+      firstPageDecoded: true,
+      toolbarPageCount: SHORT_PDF_PAGE_COUNT,
+      bytesOk: true,
+      errors: [],
+    });
+    assert.equal(verdict.ok, true);
+  });
+
+  it("still fails when the document opened without the fixture page count", () => {
+    const verdict = pdfViewerHasRendered({
+      bodyText: "1 of 12",
+      hasViewer: true,
+      firstPageDecoded: true,
+      toolbarPageCount: 12,
+      bytesOk: true,
+      errors: [],
+    });
+    assert.equal(verdict.ok, false);
+  });
+
+  it("retains HTTP/error failures as supporting rejects", () => {
+    const noBytes = pdfViewerHasRendered({
+      bodyText: "1 of 3",
+      hasViewer: true,
+      firstPageDecoded: true,
+      toolbarPageCount: 3,
+      bytesOk: false,
+      errors: [],
+    });
+    assert.equal(noBytes.ok, false);
+    const consoleError = pdfViewerHasRendered({
+      bodyText: "1 of 3",
+      hasViewer: true,
+      firstPageDecoded: true,
+      toolbarPageCount: 3,
+      bytesOk: true,
+      errors: ["engine exploded"],
+    });
+    assert.equal(consoleError.ok, false);
+  });
+
+  it("rejects the editor's actual bootstrap failure text", () => {
+    const verdict = pdfViewerHasRendered({
+      bodyText: "Lumiere could not open: the page did not start",
+      hasViewer: false,
+      firstPageDecoded: false,
+      toolbarPageCount: null,
+      bytesOk: true,
+      errors: [],
+    });
+    assert.equal(verdict.ok, false);
+    assert.equal(verdict.reason, "bootstrap error shown");
+  });
+});
+
+describe("attempt provenance", () => {
+  it("does not attribute a delayed old response that arrives after a new attempt begins", () => {
+    const previous = createAttemptLog();
+    const current = createAttemptLog();
+    previous.record("http://127.0.0.1/lumiere/file?path=pixel.png", 200);
+    assert.equal(previous.hasHttp200(), true);
+    assert.equal(
+      current.hasHttp200(),
+      false,
+      "a response that started on the previous attempt must not count for the new one",
+    );
+  });
+});
+
+describe("asynchronous readiness waits", () => {
+  it("keeps waiting after the image is visible until it is complete with positive dimensions", async () => {
+    const clock = createClock();
+    const state = {
+      currentNavHttp200: true,
+      imageCount: 1,
+      complete: false,
+      naturalWidth: 0,
+    };
+    const pending = waitForImageReady(() => Promise.resolve({ ...state }), {
+      timeout: 1000,
+      interval: 50,
+      now: clock.now,
+      sleep: clock.sleep,
+    });
+    await flush();
+    state.complete = true;
+    state.naturalWidth = 8;
+    await clock.advance(50);
+    const verdict = await pending;
+    assert.equal(
+      verdict.ok,
+      true,
+      "visible-then-later-decode must pass within the deadline",
+    );
+  });
+
+  it("times out if a visible image never decodes", async () => {
+    const clock = createClock();
+    let reads = 0;
+    const pending = waitForImageReady(
+      () => {
+        reads += 1;
+        return Promise.resolve({
+          currentNavHttp200: true,
+          imageCount: 1,
+          complete: false,
+          naturalWidth: 0,
+        });
+      },
+      { timeout: 200, interval: 50, now: clock.now, sleep: clock.sleep },
+    );
+    await flush();
+    await clock.advance(50);
+    await clock.advance(50);
+    await clock.advance(50);
+    await clock.advance(50);
+    const verdict = await pending;
+    assert.equal(verdict.ok, false);
+    assert.ok(
+      reads > 1,
+      "must poll until the deadline, not snapshot once at visibility",
+    );
+    assert.ok(clock.now() >= 200);
+  });
+
+  it("keeps waiting for a real PDF page and toolbar count after the shell is visible", async () => {
+    const clock = createClock();
+    const state = {
+      bodyText: "1 of 3",
+      hasViewer: true,
+      pageVisible: true,
+      firstPageDecoded: false,
+      toolbarPageCount: SHORT_PDF_PAGE_COUNT,
+      bytesOk: true,
+      errors: [],
+    };
+    const pending = waitForPdfReady(() => Promise.resolve({ ...state }), {
+      timeout: 1000,
+      interval: 50,
+      now: clock.now,
+      sleep: clock.sleep,
+    });
+    await flush();
+    state.firstPageDecoded = true;
+    await clock.advance(50);
+    const verdict = await pending;
+    assert.equal(verdict.ok, true);
+  });
+
+  it("stops immediately on a definitive PDF console or open error", async () => {
+    const clock = createClock();
+    let settledAt = null;
+    const pending = waitForPdfReady(
+      () =>
+        Promise.resolve({
+          bodyText: "could not be opened",
+          hasViewer: false,
+          pageVisible: false,
+          firstPageDecoded: false,
+          toolbarPageCount: null,
+          bytesOk: true,
+          errors: [],
+        }),
+      { timeout: 1000, interval: 50, now: clock.now, sleep: clock.sleep },
+    ).then((verdict) => {
+      settledAt = clock.now();
+      return verdict;
+    });
+    await flush();
+    if (settledAt === null) {
+      await clock.advance(1000);
+    }
+    const verdict = await pending;
+    assert.equal(verdict.ok, false);
+    assert.equal(verdict.reason, "PDF failed to open");
+    assert.equal(
+      settledAt,
+      0,
+      "definitive failure must not consume the deadline",
+    );
+  });
+});
+
+describe("navigation provenance", () => {
+  it("does not evaluate the previous page after a navigation failure", async () => {
+    let evaluated = false;
+    await assert.rejects(
+      () =>
+        afterSuccessfulNavigation(
+          async () => {
+            throw new Error("net::ERR_ABORTED");
+          },
+          async () => {
+            evaluated = true;
+            return imageHasDecoded({
+              currentNavHttp200: true,
+              imageCount: 1,
+              complete: true,
+              naturalWidth: 1,
+            });
+          },
+        ),
+      /ERR_ABORTED/,
+    );
+    assert.equal(evaluated, false);
+  });
+
+  it("accepts a successful 200 navigation and then runs the readiness check", async () => {
+    const verdict = await afterSuccessfulNavigation(
+      async () => ({ status: () => 200 }),
+      async () =>
+        imageHasDecoded({
+          currentNavHttp200: true,
+          imageCount: 1,
+          complete: true,
+          naturalWidth: 1,
+        }),
+    );
+    assert.equal(verdict.ok, true);
+  });
+});
diff --git a/packages/dsh/test/e2e/views-sse-check.mjs b/packages/dsh/test/e2e/views-sse-check.mjs
new file mode 100644
index 00000000..d937a0d6
--- /dev/null
+++ b/packages/dsh/test/e2e/views-sse-check.mjs
@@ -0,0 +1,310 @@
+/**
+ * Fail-closed views list + snapshot + SSE preamble checks for dsh-e2e.mjs.
+ * Extracted so a harness-free node:test can prove the contract.
+ */
+/* global TextDecoder */
+import http from "node:http";
+
+const TREE_EVENT_TYPES = new Set([
+  "changed",
+  "reveal",
+  "deselect",
+  "expand",
+  "collapse",
+]);
+
+function assert(condition, message) {
+  if (!condition) {
+    throw new Error(message);
+  }
+}
+
+async function cancelBody(body) {
+  try {
+    await body?.cancel();
+  } catch {
+    // Ignore only cancel errors so cleanup cannot hide the original failure.
+  }
+}
+
+/** Read until the first complete SSE block (`\n\n`). Exported for deterministic fixtures. */
+export async function readFirstSseBlock(body) {
+  const reader = body.getReader();
+  const decoder = new TextDecoder();
+  let buf = "";
+  try {
+    while (true) {
+      const { done, value } = await reader.read();
+      if (done) {
+        throw new Error("SSE stream ended before a complete event block");
+      }
+      buf += decoder.decode(value, { stream: true });
+      const end = buf.indexOf("\n\n");
+      if (end !== -1) {
+        return { block: buf.slice(0, end + 2), rest: buf.slice(end + 2) };
+      }
+    }
+  } finally {
+    // Release the reader so the caller's body.cancel() can close the socket.
+    try {
+      reader.releaseLock();
+    } catch {
+      // Already released or cancelled.
+    }
+  }
+}
+
+/** Validate a complete leftover `data:` block only; incomplete leftovers are ignored. */
+export function maybeAssertIncidentalTreeEvent(rest) {
+  const end = rest.indexOf("\n\n");
+  if (end === -1) {
+    return;
+  }
+  const line = rest.slice(0, end).trim();
+  if (!line.startsWith("data:")) {
+    return;
+  }
+  const payload = line.slice("data:".length).trim();
+  let event;
+  try {
+    event = JSON.parse(payload);
+  } catch {
+    throw new Error(`incidental TreeEvent is not JSON: ${payload}`);
+  }
+  assert(
+    TREE_EVENT_TYPES.has(event.type) && typeof event.viewId === "string",
+    `unexpected TreeEvent type: ${payload}`,
+  );
+}
+
+function abortError(signal, fallback) {
+  return signal?.reason instanceof Error ? signal.reason : new Error(fallback);
+}
+
+/**
+ * Send a path that fetch/WHATWG URL would reject (e.g. `%ZZ`).
+ * Honors timeoutMs/signal, destroys the socket on abort, and rejects on
+ * response error or abort so a hanging or truncated body cannot stall.
+ */
+export function rawRequest(
+  base,
+  { method = "GET", path, headers = {}, signal, timeoutMs },
+) {
+  const url = new URL(base);
+  const timeoutSignal =
+    timeoutMs === undefined
+      ? undefined
+      : globalThis.AbortSignal.timeout(timeoutMs);
+  const signals = [signal, timeoutSignal].filter(Boolean);
+  const combined =
+    signals.length === 0
+      ? undefined
+      : signals.length === 1
+        ? signals[0]
+        : globalThis.AbortSignal.any(signals);
+
+  return new Promise((resolve, reject) => {
+    let settled = false;
+    let resRef;
+    const finish = (fn, value) => {
+      if (settled) {
+        return;
+      }
+      settled = true;
+      combined?.removeEventListener("abort", onAbort);
+      fn(value);
+    };
+    const fail = (error) => {
+      try {
+        req.destroy();
+      } catch {
+        // already closed
+      }
+      try {
+        resRef?.destroy();
+      } catch {
+        // already closed
+      }
+      finish(reject, error);
+    };
+    const onAbort = () => fail(abortError(combined, "raw request aborted"));
+
+    const req = http.request(
+      {
+        hostname: url.hostname,
+        port: url.port,
+        path,
+        method,
+        headers,
+      },
+      (res) => {
+        resRef = res;
+        const chunks = [];
+        res.on("data", (chunk) => chunks.push(chunk));
+        res.on("error", (error) => fail(error));
+        res.on("aborted", () =>
+          fail(new Error("raw request response aborted")),
+        );
+        res.on("end", () => {
+          finish(resolve, {
+            status: res.statusCode ?? 0,
+            headers: res.headers,
+            body: Buffer.concat(chunks).toString("utf8"),
+          });
+        });
+      },
+    );
+    req.on("error", (error) => fail(error));
+    if (combined) {
+      if (combined.aborted) {
+        onAbort();
+        return;
+      }
+      combined.addEventListener("abort", onAbort, { once: true });
+    }
+    req.end();
+  });
+}
+
+/**
+ * Authenticated views list, one snapshot, and the events preamble.
+ * Timeout, abort, an empty views list, or a missing/invalid snapshot fail.
+ */
+export async function assertViewsSnapshotAndSse({
+  base,
+  get,
+  cookie,
+  origin,
+  timeoutMs = 3000,
+}) {
+  const list = await get(`${base}/lumiere/views`);
+  assert(list.status === 200, `views list -> ${list.status}`);
+  assert(
+    (list.headers.get("content-type") ?? "").includes("application/json"),
+    "views list is not JSON",
+  );
+  const views = await list.json();
+  assert(
+    Array.isArray(views.views) &&
+      views.views.length > 0 &&
+      views.views.every((id) => typeof id === "string"),
+    "expected a non-empty views list of string ids",
+  );
+  const id = views.views.includes("lumiere.markdown.outline")
+    ? "lumiere.markdown.outline"
+    : views.views[0];
+
+  const snapshot = await get(`${base}/lumiere/views/${encodeURIComponent(id)}`);
+  assert(snapshot.status === 200, `snapshot -> ${snapshot.status}`);
+  assert(
+    (snapshot.headers.get("content-type") ?? "").includes("application/json"),
+    "snapshot is not JSON",
+  );
+  const body = await snapshot.json();
+  assert(
+    body.viewId === id &&
+      Array.isArray(body.items) &&
+      typeof body.truncated === "boolean",
+    `snapshot shape invalid: viewId=${String(body.viewId)} truncated=${typeof body.truncated}`,
+  );
+
+  let stream;
+  try {
+    stream = await fetch(`${base}/lumiere/views/events`, {
+      headers: { Cookie: cookie, Origin: origin },
+      signal: globalThis.AbortSignal.timeout(timeoutMs),
+    });
+    assert(stream.status === 200, `events -> ${stream.status}`);
+    assert(
+      (stream.headers.get("content-type") ?? "").includes("text/event-stream"),
+      "not an SSE stream",
+    );
+    assert(
+      (stream.headers.get("cache-control") ?? "").includes("no-store"),
+      "events missing cache-control: no-store",
+    );
+    if (!stream.body) {
+      throw new Error("events response has no body");
+    }
+    const { block, rest } = await readFirstSseBlock(stream.body);
+    assert(
+      block === ": lumiere views\n\n",
+      `expected SSE preamble ": lumiere views", got ${JSON.stringify(block)}`,
+    );
+    maybeAssertIncidentalTreeEvent(rest);
+    return "views list, snapshot and SSE ok";
+  } finally {
+    await cancelBody(stream?.body);
+  }
+}
+
+/**
+ * Source-backed negatives for the views snapshot and events routes.
+ * `%ZZ` is sent with node:http because fetch rejects that path as an invalid URL.
+ * Events fetches and the raw request are bounded and cleaned up, including when
+ * an unexpected stream or hang is what the check is rejecting.
+ */
+export async function assertViewsSseNegatives({
+  base,
+  get,
+  cookie,
+  origin,
+  timeoutMs = 3000,
+}) {
+  const unknown = await get(`${base}/lumiere/views/unknown.view`);
+  assert(unknown.status === 404, `unknown view -> ${unknown.status}`);
+  const unknownBody = await unknown.json();
+  assert(
+    unknownBody.error === "No such view",
+    `unknown view body: ${JSON.stringify(unknownBody)}`,
+  );
+
+  const invalid = await rawRequest(base, {
+    path: "/lumiere/views/%ZZ",
+    headers: { Cookie: cookie, Origin: origin },
+    timeoutMs,
+  });
+  assert(invalid.status === 400, `invalid view id -> ${invalid.status}`);
+  let invalidBody;
+  try {
+    invalidBody = JSON.parse(invalid.body);
+  } catch {
+    throw new Error(`invalid view id body is not JSON: ${invalid.body}`);
+  }
+  assert(
+    invalidBody.error === "Invalid view id",
+    `invalid view id body: ${invalid.body}`,
+  );
+
+  let put;
+  try {
+    put = await fetch(`${base}/lumiere/views/events`, {
+      method: "PUT",
+      headers: { Cookie: cookie, Origin: origin },
+      signal: globalThis.AbortSignal.timeout(timeoutMs),
+    });
+    assert(put.status === 405, `PUT events -> ${put.status}`);
+    assert(
+      put.headers.get("allow") === "GET, POST, HEAD",
+      `PUT events Allow: ${put.headers.get("allow")}`,
+    );
+  } finally {
+    await cancelBody(put?.body);
+  }
+
+  let unauth;
+  try {
+    unauth = await fetch(`${base}/lumiere/views/events`, {
+      headers: { Origin: origin },
+      signal: globalThis.AbortSignal.timeout(timeoutMs),
+    });
+    assert(
+      unauth.status === 401 || unauth.status === 403,
+      `unauthenticated events -> ${unauth.status}`,
+    );
+  } finally {
+    await cancelBody(unauth?.body);
+  }
+
+  return `unknown 404, invalid 400, PUT 405, unauthenticated ${unauth.status}`;
+}
