+    rawRequest(base, {
+      path: "/lumiere/views/%ZZ",
+      headers: { Cookie: COOKIE, Origin: new URL(base).origin },
+      timeoutMs: 500,
+    }),
+  );
+});
diff --git a/packages/dsh/test/unit/frame-load.test.ts b/packages/dsh/test/unit/frame-load.test.ts
new file mode 100644
index 00000000..3f413c77
