+
+test("symlinkEscapeRefused fails on EEXIST and other unexpected symlink errors", async () => {
+  const {
+    symlinkEscapeRefused,
+    check,
+    skip,
+    results,
+    resetResults,
+    summarize,
+  } = await import(suiteUrl.href);
