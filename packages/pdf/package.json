{
  "name": "@workshop/pdf",
  "version": "0.0.0",
  "private": true,
  "description": "Lumiere PDF: an EmbedPDF-based viewer that copies selections with exact page-and-box locations.",
  "exports": {
    "./host": "./src/extension/extension.ts",
    "./portable": "./src/host/portable.ts",
    "./viewer-page": "./src/shared/viewer-page.ts",
    "./contributes.json": "./contributes.json",
    "./lazy-bridge-server": "./scripts/lazy-bridge-server.mjs"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "watch": "node scripts/build.mjs --watch",
    "typecheck": "tsc -p tsconfig.json && tsc -p src/host && tsc -p src/extension && tsc -p src/bridge-stdio && tsc -p src/webview && tsc -p src/engine-worker && tsc -p test",
    "test": "tsx --test test/unit/*.test.ts test/unit/*/*.test.ts",
    "fixtures": "node test/fixtures/make-fixtures.mjs",
    "test:browser": "node scripts/build.mjs && pnpm fixtures && playwright test --config test/browser/playwright.config.ts"
  },
  "dependencies": {
    "@embedpdf/core": "3.0.0",
    "@embedpdf/core-annotation": "3.0.0",
    "@embedpdf/core-stage": "3.0.0",
    "@embedpdf/engine": "3.0.0",
    "@embedpdf/engine-core": "3.0.0",
    "@embedpdf/engine-runtime": "3.0.0",
    "@embedpdf/engine-runtime-wasm32": "3.0.0",
    "@embedpdf/engine-services": "3.0.0",
    "@embedpdf/plugin-annotation": "3.0.0",
    "@embedpdf/plugin-history": "3.0.0",
    "@embedpdf/plugin-interaction": "3.0.0",
    "@embedpdf/plugin-link": "3.0.0",
    "@embedpdf/plugin-outline": "3.0.0",
    "@embedpdf/plugin-render": "3.0.0",
    "@embedpdf/plugin-search": "3.0.0",
    "@embedpdf/plugin-selection": "3.0.0",
    "@embedpdf/plugin-stage": "3.0.0",
    "@embedpdf/react": "3.0.0",
    "@modelcontextprotocol/sdk": "1.32.2",
    "@vscode/codicons": "0.0.45",
    "@workshop/agents": "workspace:*",
    "@workshop/core": "workspace:*",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/vscode": "1.90.0"
  }
}
