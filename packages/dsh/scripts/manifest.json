{
  "name": "@lumiere/dsh",
  "version": "0.0.0",
  "private": true,
  "description": "Lumière in DeepSeek Harness: Obsidian-style live preview for the Markdown notes in your workspace.",
  "license": "MIT",
  "type": "module",
  "main": "index.js",
  "icon": "./icon.png",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.png"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "contributed.json",
    "menus.json",
    "commands.json",
    "markdown/",
    "pdf/",
    "page/",
    "locale/*.json",
    "icon.png",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-sidebar-documentpreview",
        "@deepseek-ai/dsh-client-ui-sidebar-right"
      ]
    }
  }
}
